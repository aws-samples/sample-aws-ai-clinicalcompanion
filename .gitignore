# Lambda bundled dependencies (installed via pip -t, not committed)
# Reinstall with: pip install -r backend/lambda/websocket_authorizer/requirements.txt -t backend/lambda/websocket_authorizer/ --platform manylinux2014_x86_64 --only-binary=:all:
backend/lambda/websocket_authorizer/bin/
backend/lambda/websocket_authorizer/cffi/
backend/lambda/websocket_authorizer/cffi-*.dist-info/
backend/lambda/websocket_authorizer/cryptography/
backend/lambda/websocket_authorizer/cryptography-*.dist-info/
backend/lambda/websocket_authorizer/jwt/
backend/lambda/websocket_authorizer/pycparser/
